# Copier ce fichier en .env puis remplacer les valeurs (ne jamais committer .env)

# Base de données PostgreSQL
POSTGRES_USER=mtn_user
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=mtn_subscriptions

# Application
NODE_ENV=production
FRONTEND_PORT=8080

# Images (local par défaut ; en cloud : REGISTRY=ghcr.io/<org> et IMAGE_TAG=<version>)
REGISTRY=local
IMAGE_TAG=dev
