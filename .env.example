# Copier ce fichier en .env puis remplacer les valeurs (ne jamais committer .env)

# Base de données PostgreSQL (mot de passe : lettres et chiffres uniquement, il est inséré dans une URL)
POSTGRES_USER=mtn_user
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=mtn_subscriptions

# API : secret de signature des jetons JWT (chaîne longue et aléatoire) et compte administrateur
JWT_SECRET=changez_moi_par_une_longue_chaine_aleatoire
ADMIN_EMAIL=admin@netconnect.cm
ADMIN_PASSWORD=changez_moi_Admin2026
ADMIN_NAME=Administrateur

# Port publié sur la machine
FRONTEND_PORT=8080

# Images (local par défaut ; en cloud : REGISTRY=ghcr.io/<organisation> et IMAGE_TAG=<version>)
REGISTRY=local
IMAGE_TAG=dev
