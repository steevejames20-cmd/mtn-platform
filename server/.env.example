# Base PostgreSQL (démarrée par : npm run db:up, voir DOCKER.md). Identifiants = ceux du .env à la racine.
DATABASE_URL="postgresql://mtn_user:changez_moi@localhost:5432/mtn_subscriptions?schema=public"

# Port de l'API
PORT=4000

# Origine autorisée pour le frontend (CORS)
CLIENT_ORIGIN="http://localhost:5173"

# Secret de signature des jetons JWT — à changer !
JWT_SECRET="change-moi-par-une-longue-chaine-aleatoire"

# Compte administrateur de démonstration créé par le seed
ADMIN_EMAIL="admin@netconnect.cm"
ADMIN_PASSWORD="Admin@2026"
ADMIN_NAME="Administrateur"
